# Copie para .env e preencha os valores reais.
# Em npm run dev / Nitro, copie também as chaves de servidor para .dev.vars

# --- Postgres (obrigatório) ---
# Local com docker compose:
#   docker compose up -d postgres
#   DATABASE_URL=postgresql://welcome:welcome@127.0.0.1:5432/welcome_inn
#   npm run db:migrate
POSTGRES_USER=welcome
POSTGRES_PASSWORD=welcome
POSTGRES_DB=welcome_inn
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Local (fora do Compose): use host 127.0.0.1. No EasyPanel o entrypoint monta a URL a partir de POSTGRES_*.
DATABASE_URL=postgresql://welcome:welcome@127.0.0.1:5432/welcome_inn

# --- Dump Supabase → Postgres ---
# URI direta do Postgres no Dashboard Supabase (Database → Connection string).
# SUPABASE_DATABASE_URL=postgresql://postgres....@db....supabase.co:5432/postgres
#
# Com profiles vazio + esta URL, o container importa sozinho no boot.
# URI = Project Settings → Database → Connection string (postgresql://...), NÃO a API https://
# SUPABASE_DATABASE_URL=postgresql://postgres....@aws-0-....pooler.supabase.com:5432/postgres
# MIGRATE_FROM_SUPABASE_ON_BOOT=1   # força reimport
# MIGRATE_SKIP_IF_EMPTY=1          # não auto-importar mesmo vazio
# MIGRATE_TRUNCATE=1               # apaga destino antes
# MIGRATE_DRY_RUN=1                # NÃO use no EasyPanel — só conta, não grava (causa bootstrap)
# Manual: npm run db:migrate-from-supabase
# Guia: docs/migrate-supabase-to-postgres.md


# --- Auth JWT (obrigatório) ---
AUTH_JWT_SECRET=troque-por-um-segredo-longo
AUTH_JWT_TTL=7d

# --- TecHospitality ---
TECHOSPITALITY_BASE_URL=https://backend.techospitality.com
TECHOSPITALITY_RESERVATIONS_TOKEN=vkr_loc_
TECHOSPITALITY_CHECKOUTS_TOKEN=vkr_
TECHOSPITALITY_CREATED_TOKEN=vkr_
TECHOSPITALITY_HUB_TOKEN=vkr_chk_
TECHOSPITALITY_ADMIN_TOKEN=vkr_chk_
# TECHOSPITALITY_API_TOKEN=vkr_chk_

TECHOSPITALITY_CHECKOUTS_PATH=/api/reservations/checkouts
TECHOSPITALITY_CREATED_PATH=/api/reservations/created
TECHOSPITALITY_DASHBOARD_FEED_LIMIT=20

# --- Domínios (sandbox agora; produção depois = checkin.*) ---
# Sandbox:
PUBLIC_CHECKIN_ORIGIN=https://meucheckin.audaar.com.br
ADMIN_PANEL_ORIGIN=https://meucheckin.techospitality.com
# Produção:
# PUBLIC_CHECKIN_ORIGIN=https://checkin.audaar.com.br
# ADMIN_PANEL_ORIGIN=https://checkin.techospitality.com

# --- Inbox ---
INBOX_BASE_URL=https://inboxseg.com/api/v1/operator
INBOX_CLIENT_ID=
INBOX_CLIENT_SECRET=

# --- WhatsApp Chat ---
WHATSAPP_CHAT_API_TOKEN=
WHATSAPP_CHAT_ORGANIZATION_ID=
WHATSAPP_CHAT_INBOX_ID=
WHATSAPP_CHAT_BASE_URL=https://chat.agentslabs.cloud

# --- MinIO / S3 (fotos) ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=checkin-photos
MINIO_REGION=sa-east-1
MINIO_FORCE_PATH_STYLE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=vivakey
AWS_S3_FORCE_PATH_STYLE=true

# --- PMS VB ---
VB_PMS_BASE_URL=http://api.vinibarr.com.br/v1
VB_PMS_API_TOKEN=

# --- Turnstile (Cloudflare) — login do painel staff ---
# Precisa das DUAS chaves no runtime do container (EasyPanel / docker-compose).
# Site key pública (widget). Aceita TURNSTILE_SITE_KEY ou VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Secret key (só servidor) — obrigatória para ativar o widget.
TURNSTILE_SECRET_KEY=
# No Cloudflare Turnstile, autorize os hosts do painel (ex.: meucheckin.techospitality.com).

# --- ZepIris ---
ZEPIRIS_ENABLED=false
ZEPIRIS_ML_URL=https://photoguard.agentslabs.cloud
ZEPIRIS_API_KEY=
ZEPIRIS_TENANT=
ZEPIRIS_TIMEOUT_MS=10000
ZEPIRIS_UNAVAILABLE_POLICY=BLOCK
