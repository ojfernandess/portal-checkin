# Copie para .env e preencha os valores reais.

# --- Supabase ---
# Copie também SUPABASE_* e VITE_SUPABASE_* para .dev.vars (npm run dev / Nitro)
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- TecHospitality ---
# Também copie estes valores para .dev.vars (obrigatório em npm run dev / Cloudflare Workers)
TECHOSPITALITY_BASE_URL=https://backend.techospitality.com

# Token vkr_loc_… — localizador de reserva
# GET /api/reservations/localizer/{codigo}
TECHOSPITALITY_RESERVATIONS_TOKEN=vkr_loc_

# Token dedicado — check-outs do dia (dashboard admin)
# GET /api/reservations/checkouts?limit=20&date=YYYY-MM-DD
TECHOSPITALITY_CHECKOUTS_TOKEN=vkr_

# Token dedicado — reservas/entradas do dia (dashboard admin)
# GET /api/reservations/created?limit=20&date=YYYY-MM-DD
TECHOSPITALITY_CREATED_TOKEN=vkr_

# Token vkr_chk_… — hub check-in (lookup, media, embratur, submit)
TECHOSPITALITY_HUB_TOKEN=vkr_chk_

# Opcional — fallback para listagem genérica de reservas no admin
TECHOSPITALITY_ADMIN_TOKEN=vkr_chk_

# Opcional — um único token para todos os scopes:
# TECHOSPITALITY_API_TOKEN=vkr_chk_

# --- Dashboard admin (feeds TecHospitality) ---
TECHOSPITALITY_CHECKOUTS_PATH=/api/reservations/checkouts
TECHOSPITALITY_CREATED_PATH=/api/reservations/created
TECHOSPITALITY_DASHBOARD_FEED_LIMIT=20

# --- Deploy Docker / EasyPanel ---
# Build (ARG): VITE_SUPABASE_* — embutidos no client
# Runtime (ENV): demais variáveis acima + AWS abaixo
# Porta padrão do container: 3000 (HOST=0.0.0.0, PORT=3000)

# --- Domínios (check-in público vs painel admin) ---
# Ambos os domínios devem apontar para o MESMO serviço no EasyPanel.
# Não configure redirect global no proxy — o app redireciona por rota:
#   audaar /auth ou /admin  →  techospitality (mesmo path)
#   techospitality /        →  audaar (portal do hóspede)
PUBLIC_CHECKIN_ORIGIN=https://checkin.audaar.com.br
ADMIN_PANEL_ORIGIN=https://checkin.techospitality.com

# --- Inbox (portaria) ---
# Credenciais OAuth client_credentials — https://inboxseg.com/operadora/integracao-api
INBOX_BASE_URL=https://inboxseg.com/api/v1/operator
INBOX_CLIENT_ID=
INBOX_CLIENT_SECRET=

# --- Amazon S3 (fotos check-in: bucket vivakey) ---
# Também copie para .dev.vars (obrigatório em npm run dev / Cloudflare Workers)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=vivakey
AWS_S3_FORCE_PATH_STYLE=true

# --- Cloudflare Turnstile (login e painel admin) ---
# Site key (pública) — também em build Docker (VITE_*)
VITE_TURNSTILE_SITE_KEY=
# Secret key (servidor) — copie também para .dev.vars
TURNSTILE_SECRET_KEY=

# --- ZepIris (validação inteligente de selfies no check-in) ---
# Gateway API v1.0.0 — https://photoguard.agentslabs.cloud/docs
# Endpoints: GET /healthz, POST /v1/faces/search (multipart: id, tenant, file)
# Auth: Authorization: Bearer <ZEPIRIS_API_KEY>
ZEPIRIS_ENABLED=false
ZEPIRIS_ML_URL=https://photoguard.agentslabs.cloud
ZEPIRIS_API_KEY=
ZEPIRIS_TIMEOUT_MS=10000
ZEPIRIS_UNAVAILABLE_POLICY=BLOCK
